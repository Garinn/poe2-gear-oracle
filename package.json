{
  "name": "gear-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --import tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:pob": "POB_INTEGRATION=1 node --import tsx --test tests/pob.integration.ts",
    "setup:pob": "bash scripts/setup-pob.sh"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "express": "^5.1.0",
    "zod": "^4.0.0",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0"
  }
}
