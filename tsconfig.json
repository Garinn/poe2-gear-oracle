{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "web/**/*.ts",
    "web/**/*.vue",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
